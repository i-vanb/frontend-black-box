{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src/sdk",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/sdk/**/*.ts"],
  "exclude": ["src/sdk/**/*.test.ts"]
}
